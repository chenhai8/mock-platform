# 复制为项目根目录 .env，填写已有 MySQL 连接及现有 Nginx 访问地址
DB_URL=jdbc:mysql://YOUR_MYSQL_IP:3306/mocklab?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false
DB_USER=mocklab
DB_PASSWORD=CHANGE_ME_TO_THE_EXISTING_ACCOUNT_PASSWORD
# always 自动创建缺失的表；DBA 已完成建表时设为 never
DB_INIT_MODE=always
MOCK_BASE_URL=http://YOUR_EXISTING_NGINX_HOST
# 同机 Nginx 保持回环地址，远程 Nginx 将 APP_BIND 设置为业务服务器内网 IP
APP_BIND=127.0.0.1
APP_PORT=16080
LOG_DAYS=7
LOG_MAX_ROWS=1000000
LOG_BODY=false
